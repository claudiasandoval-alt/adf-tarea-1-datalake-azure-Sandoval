{
	"name": "df_ventas_scz_bronze_silver",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_suc_scz_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_venta as string,",
				"          fecha as string,",
				"          producto as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          sucursal as string,",
				"          vendedor as string,",
				"          cliente_nombre as string,",
				"          cliente_email as string,",
				"          metodo_pago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(vendedor = trim(vendedor),",
				"          cliente_nombre = trim(cliente_nombre),",
				"          producto = trim(producto)) ~> derivedColumn1",
				"derivedColumn1 derive(producto = initCap(regexReplace(producto, '\\\\s+', ' '))) ~> derivedColumn2",
				"derivedColumn2 derive(sucursal = iif(in(['SCZ', 'Santa Cruz', 'ST Cruz', 'santa cruz', 'SANTA CRUZ', 'SC', 'S.C.Z.', 'Santa-Cruz', 'SantaCruz', 'Sta Cruz', 'Sta. Cruz'], sucursal), 'Santa Cruz', sucursal)) ~> derivedColumn3",
				"derivedColumn3 derive(precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]', '')),",
				"          cantidad = toInteger(cantidad)) ~> derivedColumn4",
				"derivedColumn4 derive(fecha = coalesce(\r",
				"    toDate(fecha, 'yyyy-MM-dd'),\r",
				"    toDate(fecha, 'yyyy/MM/dd'),\r",
				"    toDate(fecha, 'dd/MM/yyyy'),\r",
				"    toDate(fecha, 'MM-dd-yyyy'),\r",
				"    toDate(fecha, 'dd-MMM-yyyy'),\r",
				"    toDate(fecha, 'MMMM dd, yyyy'),\r",
				"    toDate(fecha, 'MMM dd, yyyy'),\r",
				"    toDate(replace(fecha, ' de ', ' '), 'dd MMMM yyyy')\r",
				")) ~> derivedColumn5",
				"derivedColumn5 filter(!isNull(cantidad) && cantidad > 0 && !isNull(precio_unitario) && !isNull(fecha)) ~> filter1"
			]
		}
	}
}